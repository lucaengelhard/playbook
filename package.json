{
  "name": "playbook",
  "main": "dist/backend/main.js",
  "scripts": {
    "build": "tsc && cp src/backend/view/index.html dist/backend/view/index.html && mkdir -p dist/frontend && cp src/frontend/index.html dist/frontend/index.html",
    "start": "electron .",
    "check": "tsc --noEmit",
    "dev": "pnpm build && pnpm start"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "dependencies": {
    "ssh2-sftp-client": "^12.1.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "electron": "^45.2.3",
    "tsx": "^4.23.15"
  }
}
